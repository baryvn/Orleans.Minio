<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Orleans.Persistence.Minio.Core</PackageId>
		<Authors>BARRY</Authors>
		<Title>Microsoft Orleans Persistence Service for Minio</Title>
		<Description>Microsoft Orleans Persistence Service for Minio</Description>
		<PackageProjectUrl>https://github.com/baryvn/Orleans.Minio</PackageProjectUrl>
		<PackageIconUrl>https://raw.githubusercontent.com/baryvn/Orleans.Minio/main/bary-favicon-color.png</PackageIconUrl>
		<PackageTags>Orleans Cloud-Computing Actor-Model Actors Distributed-Systems Minio C# .NET</PackageTags>
		<PackageReleaseNotes></PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/baryvn/Orleans.Minio</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<IncludeSymbols>true</IncludeSymbols>
		<IncludeSource>true</IncludeSource>
		<Version>9.1.0</Version>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
</Project>
